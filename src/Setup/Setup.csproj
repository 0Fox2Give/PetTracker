<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PetTrackerSetup</AssemblyName>
    <ApplicationIcon>../../assets/PetTracker.ico</ApplicationIcon>
    <ApplicationManifest>../App/app.manifest</ApplicationManifest>
    <StartupObject>PetTracker.Setup.Program</StartupObject>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../build/payload.zip" LogicalName="PetTracker.Payload.zip" Condition="Exists('../../build/payload.zip')" />
    <EmbeddedResource Include="../../build/payload.sha256" LogicalName="PetTracker.Payload.sha256" Condition="Exists('../../build/payload.sha256')" />
    <Page Include="../App/NativeTheme.xaml" Link="NativeTheme.xaml" />
  </ItemGroup>
</Project>